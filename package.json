{
  "name": "resume-builder-root",
  "version": "1.0.0",
  "private": true,
  "description": "CleanLab AI Resume Customizer & ATS Tailor (Next.js + FastAPI)",
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && ./venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
  }
}
